{
  "name": "know-your-ammo-rewrite",
  "version": "1.0.0",
  "description": "Certified Concealed — Know Your Ammo e-book rewriting project",
  "scripts": {
    "extract": "node extract_pdf.js",
    "generate": "node generate.js",
    "generate:part1": "node generate.js --part 1 --chapters 1,2,3,4,5 --title \"Ammunition Foundations\"",
    "generate:part2": "node generate.js --part 2 --chapters 6,7,8,9,10 --title \"The Science of Stopping Power\"",
    "generate:part3": "node generate.js --part 3 --chapters 11,12,13,14,15 --title \"Caliber Deep Dives\"",
    "generate:part4": "node generate.js --part 4 --chapters 16,17,18,19,20 --title \"Advanced Ammunition Topics\"",
    "generate:part5": "node generate.js --part 5 --chapters 21,22,23,24,25 --title \"The Informed Carrier\""
  },
  "dependencies": {
    "docx": "^9.5.1",
    "localtunnel": "^2.0.2",
    "pdf-parse": "^1.1.4",
    "surge": "^0.25.0"
  }
}
